RewriteEngine On

# Domain root -> the website in /en/  (302, so browsers never cache it permanently)
RewriteRule ^$ /en/ [R=302,L]

# Old or removed pages -> their replacements (keeps old links and search results working)
RewriteRule ^en/quanticorp\.html$ /en/why-hedgeinv.html [R=301,L]
RewriteRule ^en/awards\.html$ /en/regulation.html [R=301,L]
RewriteRule ^en/ai-market-buzz\.html$ /en/market-news.html [R=301,L]
RewriteRule ^en/featured-ideas\.html$ /en/technical-views.html [R=301,L]
RewriteRule ^en/professional-economic-calendar\.html$ /en/economic-calendar.html [R=301,L]
RewriteRule ^en/forex-vps\.html$ /en/investing.html [R=301,L]
RewriteRule ^en/(?:reviewapi|Hero_Section|promotions|main)\.html$ /en/ [R=301,L]

# Sitemap and robots for whatever domain the site runs on
RewriteRule ^sitemap\.xml$ sitemap.php [END]
RewriteRule ^robots\.txt$ robots.php [END]

Options -Indexes

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
